REPOGUARD_HTTP_PORT=8088
REPOGUARD_FRONTEND_ORIGIN=http://localhost:8088
REPOGUARD_DB_PASSWORD=linux1234
REPOGUARD_MAX_UPLOAD=200MB
REPOGUARD_MAX_ARCHIVE_BYTES=209715200
