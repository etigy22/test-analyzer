REPOGUARD_MAX_EXPANDED_BYTES=524288000
REPOGUARD_MAX_FILES=25000
REPOGUARD_MALWARE_TIMEOUT=PT3M
REPOGUARD_SCANNER_TIMEOUT=PT10M
